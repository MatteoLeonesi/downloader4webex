{
  "manifest_version": 3,
  "name": "Video Downloader for Webex",
  "version": "1.0.0",
  "description": "Download Webex recordings directly from your browser",
  "permissions": [
    "activeTab",
    "downloads",
    "webRequest",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.webex.com/*",
    "*://*.wbx2.com/*",
    "*://*.ciscospark.com/*",
    "*://*.cloudfront.net/*",
    "*://*.akamaihd.net/*",
    "*://*.llnwd.net/*",
    "*://*.limelight.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.webex.com/*",
        "*://*.wbx2.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webex Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
